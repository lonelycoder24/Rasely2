# Server environment example

# Firebase Admin SDK credentials (use admin service account values)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-client-email@your-project.iam.gserviceaccount.com
# Private key needs to be provided with newlines escaped as \\nFIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"

# Optional server port
PORT=5000
