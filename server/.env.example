# Server environment example

# Port to run server on
PORT=5000

# Either provide the FIREBASE_SERVICE_ACCOUNT (JSON string) or
# set GOOGLE_APPLICATION_CREDENTIALS to a path to a service account file.
# Example: FIREBASE_SERVICE_ACCOUNT='{ "type": "service_account", "project_id": "...", ... }'
FIREBASE_SERVICE_ACCOUNT=your_service_account_json_string

# Or use a path (on server) to service account file
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json

# Optional: Firestore database URL (if needed)
FIREBASE_DATABASE_URL=https://your-project-id.firebaseio.com
